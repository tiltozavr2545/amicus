# Консоль работает ТОЛЬКО локально: сервер слушает 127.0.0.1, ключ никуда не
# уезжает и в браузер не попадает — все запросы к Supabase делает сервер.
#
# Скопировать в console/.env и заполнить. Файл уже под .gitignore (корневой
# `.env`/`.env.*`), в репозиторий не попадёт.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Project Settings → API → service_role. Это ключ, обходящий RLS целиком.
# Не публиковать, не класть в приложение, не пересылать в чат.
SUPABASE_SERVICE_ROLE_KEY=

# Порт локального API консоли. Vite проксирует на него /api.
CONSOLE_API_PORT=5174
