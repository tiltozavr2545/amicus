# The console runs ONLY locally: the server listens on 127.0.0.1, the key goes
# nowhere and never reaches the browser; the server makes all Supabase requests.
#
# Copy to console/.env and fill in. The file is already covered by .gitignore
# (the root `.env`/`.env.*`), so it won't end up in the repository.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Project Settings → API → service_role. This key bypasses RLS entirely.
# Don't publish it, don't put it in the app, don't paste it into chat.
SUPABASE_SERVICE_ROLE_KEY=

# Port of the console's local API. Vite proxies /api to it.
CONSOLE_API_PORT=5174
