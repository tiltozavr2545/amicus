<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ splits "backup" into two paths, and `allowBackup="false"` in the
  manifest only closes one of them: cloud backup. Device-to-device transfer is
  governed by this file instead, so both are named here explicitly.

  What must not leave the device: supabase_flutter persists the session — the
  access AND refresh tokens — in plain SharedPreferences
  (SharedPreferencesLocalStorage), and FeedCache writes cached posts, author
  names and signed media URLs next to it. Restored onto another handset, that
  refresh token is a live session for the account, no password involved.

  Nothing this app stores locally is worth restoring: the session is meant to
  be re-established by signing in, the theme/language prefs are two taps, and
  the feed cache exists only so the app isn't blank before the first fetch.
  So everything is excluded rather than picking through domains.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
