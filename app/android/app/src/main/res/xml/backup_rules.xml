<?xml version="1.0" encoding="utf-8"?>
<!--
  The pre-Android-12 counterpart of data_extraction_rules.xml. Redundant while
  `allowBackup="false"` stands, and kept deliberately: it is what this app's
  intent looks like to a build where that attribute is ever flipped back on
  by a merged library manifest.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
